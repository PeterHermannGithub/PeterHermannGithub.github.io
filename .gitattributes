# Line endings are pinned here because this tree is edited from both native
# Windows and WSL. Without it, the same file flips between CRLF and LF and shows
# up as a whole-file diff containing no actual change.
#
# `text=auto` normalises to LF in the repository; `eol=lf` is what forces the
# CHECKOUT side to LF too. Without it, checkout follows core.eol, which is
# `native` by default -- CRLF on Windows - and every file below that has no
# explicit rule comes back out as CRLF. The explicit rules below still win,
# because the last matching line takes precedence.

* text=auto eol=lf

# Always LF: source, config and documentation.
*.css   text eol=lf
*.html  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.svg   text eol=lf
*.txt   text eol=lf
*.xml   text eol=lf

# Binary: never normalise, never diff as text.
*.jpg  binary
*.pdf  binary
